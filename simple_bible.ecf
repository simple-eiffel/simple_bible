<?xml version="1.0" encoding="ISO-8859-1"?>
<system xmlns="http://www.eiffel.com/developers/xml/configuration-1-23-0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.eiffel.com/developers/xml/configuration-1-23-0 http://www.eiffel.com/developers/xml/configuration-1-23-0.xsd" name="simple_bible" uuid="7E24895F-CE2C-4906-AE7A-DE5868CB4165" library_target="simple_bible">
	<description>simple_bible ENGINE library (RQ-01: engine, build and app are separate ECFs). SIMPLE_BIBLE facade and BIB_ classes: results with method and citations, versification map, verse hub, search, concordance, census and shapes with all four buckets, quotations, study engines, author library, user store and note store seam, jobs (SCOOP), private plug-in seam, AI seam. Zero C (reserved prefix sbib_).</description>

	<!-- The engine library. Faces (simple_bible_app.ecf) and the build
	     pipeline (bible_build.ecf) depend on this target; it depends on no
	     face, build or network library (AC-1a-36). -->
	<target name="simple_bible">
		<root all_classes="true"/>
		<file_rule>
			<exclude>/EIFGENs$</exclude>
			<exclude>/\..*$</exclude>
		</file_rule>
		<option warning="warning">
			<assertions precondition="true" postcondition="true" check="true" invariant="true" loop="true" supplier_precondition="true"/>
		</option>
		<setting name="console_application" value="true"/>
		<setting name="dead_code_removal" value="feature"/>
		<capability>
			<concurrency support="scoop" use="scoop"/>
			<void_safety support="all" use="all"/>
		</capability>
		<library name="base" location="$ISE_LIBRARY\library\base\base.ecf"/>
		<library name="simple_mml" location="$SIMPLE_EIFFEL/simple_mml/simple_mml.ecf"/>
		<library name="simple_sql" location="$SIMPLE_EIFFEL/simple_sql/simple_sql.ecf"/>
		<library name="simple_datetime" location="$SIMPLE_EIFFEL/simple_datetime/simple_datetime.ecf"/>
		<cluster name="src" location=".\src\" recursive="true"/>
	</target>

	<!-- Test runner (fleet convention): TEST_APP runs every TEST_SET_BASE suite;
	     skeletal tests are reported as SKIP, never as passes. -->
	<target name="simple_bible_tests" extends="simple_bible">
		<root class="TEST_APP" feature="make"/>
		<setting name="console_application" value="true"/>
		<library name="testing" location="$ISE_LIBRARY\library\testing\testing.ecf"/>
		<library name="simple_testing" location="$SIMPLE_EIFFEL/simple_testing/simple_testing.ecf"/>
		<cluster name="tests" location=".\testing\" recursive="true"/>
	</target>
</system>
